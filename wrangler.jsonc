{
  "$schema": "apps/web/node_modules/wrangler/config-schema.json",
  "name": "cloudwarden-template",
  "main": "apps/web/dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  // Runs the Worker next to D1 instead of next to the visitor. Sync and login
  // make many D1 round trips; from a distant colo each one costs tens of ms.
  "placement": { "mode": "smart" },
  "workers_dev": true,
  "assets": {
    "directory": "apps/web/dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudwarden-template",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "apps/web/migrations",
      "migrations_pattern": "apps/web/migrations/*/migration.sql",
    },
  ],
  "r2_buckets": [
    {
      "binding": "VAULT_ATTACHMENTS",
      "bucket_name": "cloudwarden-template-attachments",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP_DATABASE", "class_name": "AppDatabase" }],
  },
  "exports": {
    "AppDatabase": { "type": "durable-object", "storage": "sqlite" },
  },
  "vars": {
    "APP_URL": "https://REPLACE_WITH_WORKERS_DEV_URL",
    "EMAIL_FROM": "cloudwarden@thecomputerplumbers.com",
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["cloudwarden@thecomputerplumbers.com"],
    },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
}
